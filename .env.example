# cls-studio environment variables.
# Every variable listed here is read by the code at the referenced file, and
# every value shown is the real default. This is the set an operator normally
# touches, not an exhaustive list — a few launcher-only variables live in the
# start scripts. docs/deployment.md carries the full table.

# ── Server ──────────────────────────────────────────────────────
# Bind address for the API servers (default: 127.0.0.1, local-only).
# Read by the start scripts and Dockerfiles, passed to uvicorn --host.
CLS_HOST=127.0.0.1

# ── Optional API token (LAN/reverse-proxy deployments) ─────────
# Set to a random secret to require callers to send
#   X-API-Token: <value>
# on every request to /api/v1/*. Leave blank (default) to disable
# — safe only for localhost-only deployments. See SECURITY.md.
# (apps/api/app/core/config.py)
# CLS_API_TOKEN=

# ── Storage ────────────────────────────────────────────────────
# Root directory for all project data (images, memory banks, inspection
# results) (apps/api/app/core/config.py;
# default: ~/Documents/ClsStudio/projects).
# Must point OUTSIDE the repo tree — in-repo paths are rejected at startup.
# CLS_PROJECTS_DIR=~/Documents/ClsStudio/projects

# Legacy aliases honoured only when CLS_PROJECTS_DIR is unset; the data
# root then becomes <value>/projects (apps/api/app/core/config.py).
# CLS_STATE_DIR=
# CLS_DATA_DIR=

# SQLite database path (apps/api/app/db.py;
# default: $CLS_PROJECTS_DIR/app.db)
# CLS_DB_PATH=~/Documents/ClsStudio/projects/app.db

# Reserved model directory; the server only creates <dir>/registry at startup.
# Note: this is NOT where the DINOv2 weights land - torch.hub caches those
# under TORCH_HOME (defaults to ~/.cache/torch).
# (apps/api/app/core/config.py; default: <repo>/models)
# CLS_MODELS_DIR=

# Runtime process registry (procs.json) location
# (packages/clscore/clscore/runtime/process_registry.py;
# default: ~/.cls-studio/runtime)
# CLS_RUNTIME_DIR=~/.cls-studio/runtime

# ── Runtime ────────────────────────────────────────────────────
# Torch device for inference: auto (default), cpu, cuda,
# or an explicit index like cuda:0 / cuda:1.
# (apps/api/app/core/config.py: CLS_TORCH_DEVICE)
# CLS_TORCH_DEVICE=auto

# torch.compile mode for the feature extractor: default, reduce-overhead
# (the default) or max-autotune; "off" skips compilation entirely.
# (packages/clscore/clscore/feature_extractor.py)
# CLS_COMPILE_MODE=reduce-overhead

# Directory holding the distilled BG-aware encoder checkpoints. No default —
# BG backbones refuse to load unless this is set.
# (packages/clscore/clscore/bg_backbone.py)
# CLS_BG_BACKBONE_DIR=

# Where the OpenVINO backend looks for the .xml / .bin IR pair
# (packages/clscore/clscore/backends/openvino_backbone.py; default: ./ov_ir)
# CLS_OPENVINO_IR_DIR=./ov_ir

# ── Limits and capacities ──────────────────────────────────────
# Per-image cap on normal-tier patches; 0 = uncapped
# (apps/api/app/routers/bank.py; default: 2048)
# CLS_MAX_PATCHES_PER_IMAGE=2048

# Row ceilings behind the small / medium / large bank size budgets
# (apps/api/app/routers/bank.py; defaults: 350000 / 1400000 / 4000000)
# CLS_CAPACITY_SMALL=350000
# CLS_CAPACITY_MEDIUM=1400000
# CLS_CAPACITY_LARGE=4000000

# Inspection results kept per project, oldest dropped
# (apps/api/app/routers/inspections.py; default: 200)
# CLS_INSPECTION_LOG_CAP=200

# Aggregate caps for one multi-file upload request (batch teach / staging
# drop). The 200 MB per-file limit still applies inside the request.
# (apps/api/app/core/config.py; defaults: 2048 MB / 1024 files)
# CLS_MAX_UPLOAD_TOTAL_MB=2048
# CLS_MAX_UPLOAD_FILES=1024

# ── Upstream reverse proxy (optional; OFF by default) ──────────
# cls-studio has no annotation feature of its own. These two variables only
# expose a passthrough to a separate service you already run: setting one
# mounts /cvat/* or /annotate/* and forwards requests to that URL.
# Leave both unset (the default) — the routes are then not mounted at all,
# which keeps the server free of any outbound-request (SSRF) surface on LAN
# deployments. See apps/api/app/routers/root.py and SECURITY.md.
# CLS_CVAT_URL=
# CLS_ANNOTATION_URL=

